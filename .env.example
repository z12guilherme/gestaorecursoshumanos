# ============================================================
# Variáveis de Ambiente — Gestão de Recursos Humanos
# ============================================================
# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env!
# ============================================================

# Supabase
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua_supabase_anon_key_aqui

# Modo offline (true = usa dados mock, false = usa Supabase real)
VITE_USE_MOCK=false

# Google reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=sua_recaptcha_site_key_aqui

# Groq AI — Assistente de RH Inteligente
# Obtenha sua chave em: https://console.groq.com/keys
VITE_GROQ_API_KEY=gsk_sua_chave_aqui
